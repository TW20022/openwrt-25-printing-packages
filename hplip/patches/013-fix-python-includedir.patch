--- a/configure.in
+++ b/configure.in
@@ -653,14 +653,16 @@
    AC_CHECK_PROGS(PYTHON,[python python3 python2])
    AM_PATH_PYTHON([2.2])
    AC_MSG_CHECKING([for path to Python.h])
+   if test -z "$PYTHONINCLUDEDIR"; then
    PYTHONINCLUDEDIR=`$PYTHON -c "from distutils.sysconfig import get_python_inc; print (get_python_inc());" 2>/dev/null || echo "not found"`
    if test "$PYTHONINCLUDEDIR" = "not found"; then
       AC_MSG_WARN([Failed to determine the Python include directory. Retry using sysconfig module.])
       PYTHONINCLUDEDIR=`$PYTHON -c "import sysconfig; print(sysconfig.get_path('include'))" 2>/dev/null || echo "not found"`
       if test "$PYTHONINCLUDEDIR" = "not found"; then
          AC_MSG_ERROR([Failed to determine the Python include directory. Please check your Python installation.], 6)
       fi
    fi
+   fi
    PYTHONEXECDIR="/usr/lib/python${PYTHON_VERSION}/site-packages"
    AC_MSG_RESULT("using python executable directory $PYTHONEXECDIR ....  python${PYTHON_VERSION}/Python.h")
    AC_MSG_RESULT("using python include directory $PYTHONINCLUDEDIR ....  python${PYTHON_VERSION}/Python.h")
